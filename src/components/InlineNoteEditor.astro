---
import { Bold, Ellipsis, Highlighter, Italic, Save, Strikethrough, X } from '@lucide/astro';
---

<section class="inline-note-editor" data-inline-editor hidden aria-label="正文轻量编辑" role="toolbar">
  <div class="inline-editor-head">
    <span data-inline-selection aria-live="polite"></span>
    <div class="inline-editor-actions">
      <button type="button" data-inline-save disabled aria-label="保存标注" title="保存"><Save /></button>
      <button type="button" data-inline-cancel aria-label="取消待保存修改" title="取消修改"><X /></button>
      <button type="button" data-inline-launch aria-label="关闭标注工具" title="关闭工具"><X /></button>
    </div>
  </div>
  <div class="inline-editor-tools" data-inline-tools>
    <div class="inline-tool-group" aria-label="文字格式">
      <button type="button" data-inline-format="bold" aria-label="加粗" title="加粗"><Bold /></button>
      <button type="button" data-inline-format="italic" aria-label="斜体" title="斜体"><Italic /></button>
      <button type="button" data-inline-format="strike" aria-label="删除线" title="删除线"><Strikethrough /></button>
      <button type="button" data-inline-format="mark" aria-label="荧光高亮" title="荧光高亮"><Highlighter /></button>
    </div>
    <div class="inline-tool-group inline-color-group" aria-label="文字底色">
      <button type="button" data-inline-format="yellow" aria-label="黄色底色" title="黄色底色"><span class="inline-color inline-color-yellow"></span></button>
      <button type="button" data-inline-format="green" aria-label="绿色底色" title="绿色底色"><span class="inline-color inline-color-green"></span></button>
      <button type="button" data-inline-format="blue" aria-label="蓝色底色" title="蓝色底色"><span class="inline-color inline-color-blue"></span></button>
    </div>
    <button class="inline-more-toggle" type="button" data-inline-more aria-label="更多文字操作" title="更多操作"><Ellipsis /></button>
  </div>
  <div class="inline-editor-more" data-inline-more-menu hidden>
    <button type="button" data-inline-text="replace">替换文字</button>
    <button type="button" data-inline-text="before">在前面插入</button>
    <button type="button" data-inline-text="after">在后面插入</button>
    <button type="button" data-inline-text="delete">删除选区</button>
  </div>
  <p class="inline-editor-status" data-inline-status role="status" aria-live="polite"></p>
</section>

<dialog class="inline-editor-dialog" data-inline-dialog aria-labelledby="inline-editor-dialog-title">
  <form data-inline-login-form hidden>
    <h2 id="inline-editor-dialog-title">管理员验证</h2>
    <p>轻量编辑仍会写入在线笔记，请输入管理员密码。</p>
    <label>管理员密码<input type="password" data-inline-password autocomplete="current-password" required minlength="1" /></label>
    <p class="inline-dialog-error" data-inline-login-error role="alert" hidden></p>
    <div class="inline-dialog-actions"><button type="button" data-inline-dialog-cancel>取消</button><button type="submit" value="login">验证并继续</button></div>
  </form>
  <form data-inline-text-form hidden>
    <h2 data-inline-text-title>修改选中文字</h2>
    <p data-inline-text-hint></p>
    <label>文字内容<textarea data-inline-text-value rows="5" maxlength="4000"></textarea></label>
    <div class="inline-dialog-actions"><button type="button" data-inline-dialog-cancel>取消</button><button type="submit" value="apply">应用</button></div>
  </form>
</dialog>

<script>
  import { liveApiHeaders, liveApiUrl } from '../lib/live-backend';
  import { computePosition, offset, flip, shift } from '@floating-ui/dom';
  import { mapSelectionToMarkdown } from '../lib/markdown-edit.mjs';

  type LiveNote = { id: string; path: string; type: string; title: string; version: number; markdown?: string; assets?: Array<{ relative_path: string; url: string }> };
  type SelectionInfo = { block: HTMLElement; start: number; end: number; startLine: number; endLine: number; text: string };

  const root = document.querySelector<HTMLElement>('[data-inline-editor]');
  const layout = document.querySelector<HTMLElement>('.note-reading-layout[data-note-id]');
  const article = layout?.querySelector<HTMLElement>('.note-prose');
  const dialog = root?.parentElement?.querySelector<HTMLDialogElement>('[data-inline-dialog]') ?? document.querySelector<HTMLDialogElement>('[data-inline-dialog]');
  if (root && layout && article && dialog) {
    const tools = root.querySelector<HTMLElement>('[data-inline-tools]')!;
    const selectionLabel = root.querySelector<HTMLElement>('[data-inline-selection]')!;
    const status = root.querySelector<HTMLElement>('[data-inline-status]')!;
    const save = root.querySelector<HTMLButtonElement>('[data-inline-save]')!;
    const loginForm = dialog.querySelector<HTMLFormElement>('[data-inline-login-form]')!;
    const textForm = dialog.querySelector<HTMLFormElement>('[data-inline-text-form]')!;
    const password = dialog.querySelector<HTMLInputElement>('[data-inline-password]')!;
    const textValue = dialog.querySelector<HTMLTextAreaElement>('[data-inline-text-value]')!;
    const textTitle = dialog.querySelector<HTMLElement>('[data-inline-text-title]')!;
    const textHint = dialog.querySelector<HTMLElement>('[data-inline-text-hint]')!;
    const loginError = dialog.querySelector<HTMLElement>('[data-inline-login-error]')!;
    const loginSubmit = loginForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const launch = root.querySelector<HTMLButtonElement>('[data-inline-launch]')!;
    const moreToggle = root.querySelector<HTMLButtonElement>('[data-inline-more]')!;
    const moreMenu = root.querySelector<HTMLElement>('[data-inline-more-menu]')!;
    let note: LiveNote | null = null;
    let source = '';
    let pending = '';
    let selection: SelectionInfo | null = null;
    let actionAfterLogin: (() => void) | null = null;
    let csrf = '';
    let dialogMode: 'login' | 'text' = 'login';
    let toolbarRect: DOMRect | null = null;
    let toolbarClosed = false;
    let toolbarRange: Range | null = null;
    let positionRevision = 0;

    const say = (message: string) => { status.textContent = message; };
    const normalize = (value: string) => value.replace(/\s+/g, ' ').trim();
    const protectedSelector = 'a,code,pre,table,img,video,svg,.katex,.hljs,.note-code-block';
    const closestBlock = (node: Node): HTMLElement | null => {
      const element = node.nodeType === Node.ELEMENT_NODE ? node as Element : node.parentElement;
      return element?.closest<HTMLElement>('[data-search-passage],h1,h2,h3,h4,h5,h6,p,li,td,th') ?? null;
    };
    const hasProtectedContent = (range: Range, block: HTMLElement) => {
      const startElement = range.startContainer.nodeType === Node.ELEMENT_NODE ? range.startContainer as Element : range.startContainer.parentElement;
      const endElement = range.endContainer.nodeType === Node.ELEMENT_NODE ? range.endContainer as Element : range.endContainer.parentElement;
      if (startElement?.closest(protectedSelector) || endElement?.closest(protectedSelector)) return true;
      const fragment = range.cloneContents();
      return Boolean(fragment.querySelector(protectedSelector)) || Boolean(block.closest(protectedSelector));
    };
    const textOffset = (block: HTMLElement, container: Node, offset: number) => {
      const prefix = document.createRange();
      prefix.selectNodeContents(block);
      prefix.setEnd(container, offset);
      return prefix.cloneContents().textContent?.length ?? 0;
    };
    const mapSelection = (range: Range): SelectionInfo | null => {
      if (!note || !source) return null;
      const startBlock = closestBlock(range.startContainer); const endBlock = closestBlock(range.endContainer);
      if (!startBlock || startBlock !== endBlock || hasProtectedContent(range, startBlock)) return null;
      const start = textOffset(startBlock, range.startContainer, range.startOffset);
      const end = textOffset(startBlock, range.endContainer, range.endOffset);
      const text = range.toString();
      if (!text.trim() || end <= start) return null;
      const startLine = Number(startBlock.dataset.sourceStart);
      const endLine = Number(startBlock.dataset.sourceEnd);
      if (!Number.isInteger(startLine) || !Number.isInteger(endLine)) return null;
      return { block: startBlock, start, end, startLine, endLine, text };
    };
    const patchSource = (info: SelectionInfo, operation: string, value = '', wrapper?: { before: string; after: string }): string | null => {
      const base = pending || source;
      const mapped = mapSelectionToMarkdown(base, info.startLine, info.endLine, info.block.textContent ?? '', info.start, info.end);
      if (!mapped) return null;
      const selectedRaw = base.slice(mapped.start, mapped.end);
      const replacement = wrapper ? `${wrapper.before}${selectedRaw}${wrapper.after}` : operation === 'delete' ? '' : operation === 'before' ? `${value}${selectedRaw}` : operation === 'after' ? `${selectedRaw}${value}` : operation === 'replace' ? value : selectedRaw;
      return `${base.slice(0, mapped.start)}${replacement}${base.slice(mapped.end)}`;
    };
    const positionToolbar = async () => {
      if (root.hidden || !toolbarRect) return;
      const revision = ++positionRevision;
      const anchor = { getBoundingClientRect: () => toolbarRange?.startContainer.isConnected ? toolbarRange.getBoundingClientRect() : toolbarRect!, contextElement: article };
      const position = await computePosition(anchor, root, { placement: 'top', strategy: 'fixed', middleware: [offset(10), flip({ padding: 8 }), shift({ padding: 8 })] });
      if (revision !== positionRevision || root.hidden) return;
      root.style.left = `${Math.round(position.x)}px`;
      root.style.top = `${Math.round(position.y)}px`;
    };
    const showToolbar = (rect: DOMRect) => {
      toolbarRect = rect;
      toolbarClosed = false;
      root.hidden = false;
      tools.hidden = false;
      requestAnimationFrame(positionToolbar);
    };
    const hideToolbar = () => {
      root.hidden = true;
      toolbarRect = null; toolbarRange = null;
    };
    const setToolbar = (enabled: boolean, rect?: DOMRect) => {
      selectionLabel.textContent = enabled && selection ? normalize(selection.text).slice(0, 80) : '';
      tools.hidden = !enabled;
      if (!enabled) moreMenu.hidden = true;
      if (enabled && rect && !toolbarClosed) showToolbar(rect);
      else if (!pending) hideToolbar();
      else requestAnimationFrame(positionToolbar);
    };
    const rememberSelection = () => {
      const current = window.getSelection();
      if (!current || current.rangeCount === 0 || current.isCollapsed || !article.contains(current.anchorNode) || !article.contains(current.focusNode)) {
        selection = null;
        if ('highlights' in CSS) (CSS as any).highlights.delete('note-inline-selection');
        if (!pending) hideToolbar();
        return;
      }
      toolbarRange = current.getRangeAt(0).cloneRange();
      const mapped = mapSelection(toolbarRange);
      selection = mapped;
      if (mapped && 'highlights' in CSS && 'Highlight' in window) {
        const highlights = (CSS as any).highlights as Map<string, unknown>;
        highlights.set('note-inline-selection', new (window as any).Highlight(current.getRangeAt(0).cloneRange()));
      } else if ('highlights' in CSS) (CSS as any).highlights.delete('note-inline-selection');
      setToolbar(Boolean(mapped), mapped ? current.getRangeAt(0).getBoundingClientRect() : undefined);
      if (!mapped) say('选区需要位于同一个普通正文块内；公式、链接、代码、图片和表格请到管理页修改。');
    };
    const openDialog = (mode: 'login' | 'text') => {
      dialogMode = mode;
      loginForm.hidden = mode !== 'login';
      textForm.hidden = mode !== 'text';
      loginError.hidden = true;
      loginError.textContent = '';
      if (!dialog.open) dialog.showModal();
      requestAnimationFrame(() => (mode === 'login' ? password : textValue).focus());
    };
    const ensureAdmin = async (next: () => void) => {
      try {
        const response = await fetch(liveApiUrl('/api/admin/session'), { cache: 'no-store', headers: liveApiHeaders() });
        const data = await response.json().catch(() => ({}));
        if (data.authenticated) { csrf = data.csrfToken || csrf; next(); return; }
        actionAfterLogin = next; openDialog('login');
      } catch (error) {
        say(error instanceof Error ? `无法连接在线笔记服务：${error.message}` : '无法连接在线笔记服务。');
      }
    };
    const applyPatch = (operation: string, value = '', wrapper?: { before: string; after: string }) => {
      if (!selection) return say('请先选中正文中的一段文字。');
      const patched = patchSource(selection, operation, value, wrapper);
      if (patched === null) return say('该选区包含不能安全改写的 Markdown 结构，请在管理页检查源码。');
      pending = patched; save.disabled = false; say('已预览修改，保存后对所有访客生效。'); selection = null; setToolbar(false); selectionLabel.textContent = '修改预览'; window.getSelection()?.removeAllRanges();
      document.dispatchEvent(new CustomEvent('notes:inline-preview', { detail: { noteId: note?.id, markdown: pending } }));
    };
    const openTextAction = (action: string) => {
      if (!selection) return say('请先选中正文中的一段文字。');
      textTitle.textContent = action === 'delete' ? '删除选中文字' : action === 'replace' ? '替换选中文字' : action === 'before' ? '在选中文字前插入' : '在选中文字后插入';
      textHint.textContent = action === 'delete' ? '删除后可在保存前取消本次改动。' : '只会影响当前选中的纯文本位置。';
      textValue.value = ''; textValue.required = action !== 'delete'; textValue.disabled = action === 'delete'; textValue.placeholder = action === 'delete' ? '无需填写' : '输入文字';
      textForm.dataset.action = action; openDialog('text');
    };
    root.querySelectorAll<HTMLButtonElement>('[data-inline-format]').forEach((button) => button.addEventListener('pointerdown', (event) => event.preventDefault()));
    root.querySelectorAll<HTMLButtonElement>('[data-inline-text]').forEach((button) => button.addEventListener('pointerdown', (event) => event.preventDefault()));
    root.querySelectorAll<HTMLButtonElement>('[data-inline-format]').forEach((button) => button.addEventListener('click', () => {
      const kind = button.dataset.inlineFormat!;
      const formats: Record<string, { before: string; after: string }> = {
        bold: { before: '**', after: '**' }, italic: { before: '*', after: '*' }, strike: { before: '~~', after: '~~' },
        mark: { before: '<mark>', after: '</mark>' }, yellow: { before: '<span style="background-color: #fff2a8">', after: '</span>' },
        green: { before: '<span style="background-color: #d7f5dd">', after: '</span>' }, blue: { before: '<span style="background-color: #d9ecff">', after: '</span>' },
      };
      const wrapper = formats[kind];
      if (!wrapper) return;
      ensureAdmin(() => applyPatch('wrap', '', wrapper));
    }));
    root.querySelectorAll<HTMLButtonElement>('[data-inline-text]').forEach((button) => button.addEventListener('click', () => openTextAction(button.dataset.inlineText!)));
    moreToggle.addEventListener('pointerdown', (event) => event.preventDefault());
    moreToggle.addEventListener('click', () => { moreMenu.hidden = !moreMenu.hidden; moreToggle.setAttribute('aria-expanded', String(!moreMenu.hidden)); requestAnimationFrame(positionToolbar); });
    launch.addEventListener('click', () => {
      if (pending) { say('请先保存或取消当前改动。'); return; }
      toolbarClosed = true;
      selection = null;
      window.getSelection()?.removeAllRanges();
      if ('highlights' in CSS) (CSS as any).highlights.delete('note-inline-selection');
      hideToolbar();
    });
    save.addEventListener('click', () => void ensureAdmin(async () => {
      if (!note || !pending) return;
      save.disabled = true;
      try {
        const response = await fetch(liveApiUrl(`/api/admin/notes/${encodeURIComponent(note.id)}/markdown`), { method: 'PUT', cache: 'no-store', headers: liveApiHeaders({ 'content-type': 'application/json', 'x-csrf-token': csrf }), body: JSON.stringify({ expectedVersion: note.version, content: pending }) });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || (response.status === 409 ? '笔记已被其他窗口修改，请刷新后重试。' : '保存失败，请稍后重试。'));
        note = { ...note, version: data.version, markdown: pending }; source = pending; pending = '';
        say(`已发布版本 ${data.version}，正文和目录已更新。`);
        document.dispatchEvent(new CustomEvent('notes:note-saved', { detail: note }));
        hideToolbar();
      } catch (error) { save.disabled = false; say(error instanceof Error ? error.message : '保存失败，请稍后重试。'); }
    }));
    root.querySelector<HTMLButtonElement>('[data-inline-cancel]')!.addEventListener('click', () => { pending = ''; save.disabled = true; selection = null; setToolbar(false); say('已撤销未保存预览。'); document.dispatchEvent(new CustomEvent('notes:inline-preview', { detail: { noteId: note?.id, markdown: source } })); });
    loginForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (dialogMode !== 'login') return;
      loginSubmit.disabled = true;
      loginError.hidden = true;
      try {
        const response = await fetch(liveApiUrl('/api/auth/login'), { method: 'POST', headers: liveApiHeaders({ 'content-type': 'application/json' }), body: JSON.stringify({ password: password.value }) });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || '管理员验证失败');
        sessionStorage.setItem('notes-admin-session', data.accessToken); csrf = data.csrfToken || '';
        password.value = ''; dialog.close(); const action = actionAfterLogin; actionAfterLogin = null; action?.();
      } catch (error) {
        loginError.textContent = error instanceof Error ? error.message : '管理员验证失败';
        loginError.hidden = false;
        password.select();
      } finally { loginSubmit.disabled = false; }
    });
    textForm.addEventListener('submit', (event) => {
      event.preventDefault();
      if (dialogMode !== 'text') return;
      const action = textForm.dataset.action || 'replace'; const value = textValue.value;
      if (action !== 'delete' && !value) return say('请输入要插入或替换的文字。');
      dialog.close(); ensureAdmin(() => applyPatch(action, value));
    });
    dialog.querySelectorAll<HTMLButtonElement>('[data-inline-dialog-cancel]').forEach((button) => button.addEventListener('click', () => { actionAfterLogin = null; dialog.close(); }));
    dialog.addEventListener('close', () => { loginForm.hidden = true; textForm.hidden = true; loginSubmit.disabled = false; });
    document.addEventListener('selectionchange', () => {
      if (dialog.open || root.contains(document.activeElement)) return;
      requestAnimationFrame(rememberSelection);
    });
    window.addEventListener('beforeunload', (event) => { if (pending) { event.preventDefault(); } });
    article.addEventListener('mouseup', rememberSelection); article.addEventListener('keyup', rememberSelection);
    window.addEventListener('scroll', positionToolbar, { passive: true });
    window.addEventListener('resize', positionToolbar);
    document.addEventListener('mousedown', (event) => {
      const target = event.target as Node | null;
      if (!target || root.contains(target) || article.contains(target) || dialog.contains(target)) return;
      selection = null;
      if (!pending) hideToolbar();
    });
    document.addEventListener('notes:live-note', (event) => {
      const incoming = (event as CustomEvent<LiveNote>).detail;
      if (!incoming || incoming.type !== 'markdown' || typeof incoming.markdown !== 'string') return;
      note = incoming; source = incoming.markdown; pending = ''; selection = null; toolbarClosed = false; hideToolbar(); save.disabled = true; moreMenu.hidden = true; say('');
    });
  }
</script>

<style>
  /* Starlight applies paragraph spacing to every adjacent descendant. This
     toolbar is UI inside a Markdown wrapper; only its explicit gaps may space it. */
  .inline-note-editor :global(*) { margin: 0 !important; }
  .inline-note-editor { position: fixed; z-index: 120; display: grid; width: max-content; max-width: min(23rem, calc(100vw - 1rem)); gap: .35rem; margin: 0; padding: .42rem; border: 1px solid color-mix(in srgb, var(--sl-color-accent) 32%, var(--sl-color-gray-5)); border-radius: 10px; background: color-mix(in srgb, var(--sl-color-bg) 97%, transparent); box-shadow: 0 10px 32px #07150e2b, 0 2px 8px #07150e18; backdrop-filter: blur(16px); }
  .inline-note-editor[hidden], .inline-editor-tools[hidden], .inline-editor-more[hidden], .inline-editor-dialog [hidden] { display: none !important; }
  .inline-editor-head { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: .6rem; padding: 0 .12rem; }
  .inline-editor-head > span { display: block; max-width: 13rem; overflow: hidden; color: var(--sl-color-text); font-size: .76rem; font-weight: 550; text-overflow: ellipsis; white-space: nowrap; }
  .inline-editor-actions { display: flex; align-items: center; gap: .16rem; }
  .inline-editor-head button, .inline-editor-tools button { display: inline-grid; width: 2rem; height: 2rem; place-items: center; padding: 0; border: 1px solid transparent; border-radius: 6px; background: transparent; color: var(--sl-color-gray-2); cursor: pointer; }
  .inline-editor-head button svg, .inline-editor-tools button svg { width: 1rem; height: 1rem; stroke-width: 1.8; }
  .inline-editor-head [data-inline-save] { border-color: var(--sl-color-accent); background: var(--sl-color-accent); color: white; }
  .inline-editor-head [data-inline-save]:disabled { border-color: transparent; background: var(--sl-color-gray-6); color: var(--sl-color-gray-3); cursor: not-allowed; }
  .inline-editor-head [data-inline-cancel] { color: var(--sl-color-red-high); }
  .inline-editor-head button:hover:not(:disabled), .inline-editor-tools button:hover { border-color: var(--sl-color-gray-5); background: var(--sl-color-gray-6); color: var(--sl-color-text); }
  .inline-editor-tools { display: flex; align-items: center; gap: .22rem; }
  .inline-tool-group { display: flex; align-items: center; gap: .1rem; padding-right: .28rem; border-right: 1px solid var(--sl-color-gray-5); }
  .inline-tool-group button[aria-pressed='true'] { background: var(--sl-color-accent-low); color: var(--sl-color-accent-high); }
  .inline-color-group { gap: .25rem; }
  .inline-color { display: block; width: 1rem; height: 1rem; border: 1px solid #0002; border-radius: 50%; box-shadow: inset 0 0 0 2px var(--sl-color-bg); }
  .inline-color-yellow { background: #f5cf45; }
  .inline-color-green { background: #65bd86; }
  .inline-color-blue { background: #61a7e8; }
  .inline-more-toggle { margin-left: auto !important; }
  .inline-editor-more { display: grid; grid-template-columns: 1fr 1fr; gap: .15rem; padding: .3rem 0 0; border-top: 1px solid var(--sl-color-gray-5); }
  .inline-editor-more button { padding: .48rem .58rem; border: 0; border-radius: 4px; background: transparent; color: var(--sl-color-text); text-align: left; font: .76rem/1.3 var(--sl-font); cursor: pointer; }
  .inline-editor-more button:hover { background: var(--sl-color-gray-6); }
  .inline-editor-status { margin: 0; padding: 0 .15rem; color: var(--sl-color-gray-3); font-size: .66rem; line-height: 1.35; }
  .inline-editor-status:empty { display: none; }
  :global(::highlight(note-inline-selection)) { background-color: #b8efce; color: inherit; }
  .inline-editor-dialog { width: min(28rem, calc(100vw - 2rem)); padding: 1.2rem; border: 1px solid var(--sl-color-gray-5); border-radius: 9px; background: var(--sl-color-bg); color: var(--sl-color-text); box-shadow: 0 18px 60px #0004; }
  .inline-editor-dialog::backdrop { background: #07150e88; backdrop-filter: blur(2px); }
  .inline-editor-dialog h2 { margin: 0 0 .55rem; font-size: 1rem; }
  .inline-editor-dialog p { margin: .4rem 0 .8rem; color: var(--sl-color-gray-3); font-size: .8rem; line-height: 1.6; }
  .inline-editor-dialog label { display: grid; gap: .35rem; color: var(--sl-color-gray-2); font-size: .78rem; }
  .inline-editor-dialog input, .inline-editor-dialog textarea { width: 100%; box-sizing: border-box; padding: .55rem .65rem; border: 1px solid var(--sl-color-gray-5); border-radius: 5px; background: var(--sl-color-bg-nav); color: var(--sl-color-text); font: inherit; }
  .inline-dialog-actions { display: flex; justify-content: flex-end; gap: .5rem; margin-top: 1rem; }
