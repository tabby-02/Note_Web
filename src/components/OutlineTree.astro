---
interface Entry { id: string; text: string; level: number; children: Entry[] }
interface Props { entries: Entry[]; firstLevel: number; nested?: boolean; collapsed?: boolean }
const { entries, firstLevel, nested = false, collapsed = false } = Astro.props;
---
<ul data-outline-children={nested || undefined} hidden={collapsed}>
  {entries.map((entry) => {
    const openByDefault = entry.level === firstLevel;
    return (
      <li data-outline-item data-level={entry.level} data-depth={entry.level - firstLevel}>
        <div class="outline-row" style={`--outline-depth:${entry.level - firstLevel}`}>
          <a href={`#${entry.id}`} title={entry.text} data-outline-target={entry.id} {...(entry.children.length > 0 ? { 'data-outline-branch': '', 'aria-expanded': openByDefault, 'aria-label': `${openByDefault ? '收起' : '展开'}${entry.text}的子目录` } : {})}>
            <span class="outline-label">{entry.text}</span>
            {entry.children.length > 0 && <span class="outline-branch-icon" aria-hidden="true">›</span>}
          </a>
        </div>
        {entry.children.length > 0 && <Astro.self entries={entry.children} firstLevel={firstLevel} nested collapsed={!openByDefault} />}
      </li>
    );
  })}
</ul>

<script>
  const setExpanded = (link: HTMLAnchorElement, expanded: boolean) => {
    link.setAttribute('aria-expanded', String(expanded));
    const label = link.querySelector<HTMLElement>('.outline-label')?.textContent?.trim() ?? link.textContent?.trim() ?? '';
    link.setAttribute('aria-label', `${expanded ? '收起' : '展开'}${label}的子目录`);
    const children = link.closest('li')?.querySelector<HTMLElement>(':scope > [data-outline-children]');
    if (children) children.hidden = !expanded;
  };
  const revealTarget = (link: HTMLAnchorElement) => {
    const rawId = link.dataset.outlineTarget ?? link.getAttribute('href')?.slice(1) ?? '';
    let id = rawId;
    try { id = decodeURIComponent(rawId); } catch {}
    const target = document.getElementById(rawId) ?? document.getElementById(id);
    if (!target) return;
    if (link.hash) history.replaceState(null, '', link.hash);
    requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
  };
  document.querySelectorAll<HTMLAnchorElement>('[data-outline-branch]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const expanded = link.getAttribute('aria-expanded') !== 'true';
      setExpanded(link, expanded);
      revealTarget(link);
      const allButton = document.querySelector<HTMLButtonElement>('[data-outline-toggle-all]');
      allButton?.setAttribute('aria-pressed', 'false');
      if (allButton) allButton.textContent = '全部展开';
    });
  });

  const tree = document.querySelector<HTMLElement>('[data-outline-tree]');
  const toggleAll = document.querySelector<HTMLButtonElement>('[data-outline-toggle-all]');
  toggleAll?.addEventListener('click', () => {
    if (!tree || !toggleAll) return;
    const expand = toggleAll.getAttribute('aria-pressed') !== 'true';
    tree.querySelectorAll<HTMLAnchorElement>('[data-outline-branch]').forEach((link) => {
      setExpanded(link, expand);
    });
    toggleAll.setAttribute('aria-pressed', String(expand));
    toggleAll.textContent = expand ? '收起全部' : '全部展开';
  });
</script>

<style>
  ul { padding: 0; margin: 0; list-style: none; }
  li { padding: 0; margin: 0; }
  .outline-row { margin: 0; padding-inline-start: calc(var(--outline-depth) * .55rem); }
  .outline-row > a { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: .45rem; padding: .38rem .5rem; border-inline-start: 2px solid transparent; border-radius: 0 5px 5px 0; color: var(--sl-color-gray-3); font-size: .75rem; line-height: 1.5; overflow-wrap: anywhere; text-decoration: none; }
  .outline-row > a:hover { color: var(--sl-color-accent-high); background: var(--sl-color-gray-6); }
  .outline-label { min-width: 0; }
  .outline-branch-icon { flex: 0 0 auto; color: var(--sl-color-gray-3); font-size: 1rem; line-height: 1; transition: transform .16s ease; }
  a[data-outline-branch][aria-expanded='true'] .outline-branch-icon { transform: rotate(90deg); color: var(--sl-color-accent-high); }
  [data-outline-item][data-depth='0'] > .outline-row > a { color: var(--sl-color-gray-2); font-size: .8rem; font-weight: 650; }
  .outline-row > a[aria-current='location'] { border-color: var(--sl-color-accent); background: var(--sl-color-accent-low); color: var(--sl-color-accent-high); }
</style>
