{
  "name": "learning-notes-library",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "manage": "node scripts/note-manager/server.mjs",
    "test:manager": "node --test scripts/note-manager/*.test.mjs",
    "test:search": "node --test scripts/note-search.test.mjs",
    "test:markdown": "node --test scripts/note-markdown.test.mjs",
    "test:assets": "node --test scripts/markdown-assets.test.mjs src/lib/live-upload.test.mjs",
    "test:inline-edit": "node --test src/lib/markdown-edit.test.mjs",
    "test:reading": "node --test scripts/note-outline.test.mjs",
    "supabase:import:dry": "node scripts/supabase-import.mjs --dry-run",
    "supabase:import": "node scripts/supabase-import.mjs",
    "supabase:import:initial": "node scripts/supabase-import.mjs --confirm-initial-import",
    "supabase:sync:check": "node scripts/supabase-sync.mjs --check",
    "supabase:sync:guard": "node scripts/supabase-sync.mjs --check --fail-on-drift",
    "supabase:sync:snapshot": "node scripts/supabase-sync.mjs --snapshot",
    "supabase:sync:publish-local": "node scripts/supabase-sync-publish.mjs",
    "supabase:check": "deno check --config supabase/functions/deno.json supabase/functions/site-api/index.ts",
    "supabase:link": "supabase link --project-ref qsfwywubqvahisqprvxu",
    "supabase:deploy": "supabase functions deploy site-api --no-verify-jwt --use-api",
    "supabase:secrets": "node scripts/supabase-set-secrets.mjs",
    "predev": "node scripts/prepare-notes.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/prepare-notes.mjs && node scripts/validate-notes.mjs",
    "build": "astro build",
    "postbuild": "node scripts/validate-site.mjs",
    "preview": "astro preview",
    "precheck": "node scripts/prepare-notes.mjs",
    "check": "astro check",
    "supabase:sync:review": "node scripts/supabase-sync.mjs --review",
    "test:sync": "node --test scripts/sync-model.test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/starlight": "^0.42.8",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@floating-ui/dom": "^1.8.0",
    "@lucide/astro": "^1.67.0",
    "astro": "^7.4.5",
    "cheerio": "^1.2.0",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "image-size": "^2.0.4",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-texmath": "^1.0.0",
    "pagefind": "^1.6.0",
    "pdfjs-dist": "^6.5.438",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@supabase/supabase-js": "^2.119.0",
    "deno": "^2.9.6",
    "supabase": "^3.2.0",
    "typescript": "^6.0.3"
  }
}
