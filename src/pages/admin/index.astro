---
import 'katex/dist/katex.min.css';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>笔记管理</title>
    <style>
      :root { color-scheme: light dark; font-family: Inter, "Microsoft YaHei", system-ui, sans-serif; --admin-bg: #f4f7f5; --admin-panel: #fff; --admin-line: #d7e1db; --admin-muted: #637268; --admin-accent: #26765a; --admin-accent-soft: #e2f0e9; }
      @media (prefers-color-scheme: dark) { :root { --admin-bg: #121a16; --admin-panel: #1b2620; --admin-line: #36453c; --admin-muted: #a4b4aa; --admin-accent: #72d2a6; --admin-accent-soft: #203b2f; } }
      * { box-sizing: border-box; }
      body { max-width: 1380px; min-height: 100vh; margin: 0 auto; padding: 1.5rem clamp(1rem, 3vw, 3rem) 4rem; background: var(--admin-bg); color: CanvasText; }
      header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--admin-line); }
      header h1 { margin: 0; color: var(--admin-accent); font-size: clamp(1.25rem, 2vw, 1.7rem); letter-spacing: .02em; }
      header p { margin: .25rem 0 0; color: var(--admin-muted); font-size: .78rem; }
      header a { color: var(--admin-accent); font-size: .8rem; font-weight: 650; text-decoration: none; }
      header a:hover { text-decoration: underline; }
      h2, h3 { margin: 0; }
      button, input, select, textarea { font: inherit; color: inherit; }
      button, select, input { min-height: 2.25rem; padding: .5rem .7rem; border: 1px solid var(--admin-line); border-radius: 6px; background: var(--admin-panel); }
      button { cursor: pointer; font-size: .8rem; font-weight: 600; }
      button:hover { border-color: var(--admin-accent); background: var(--admin-accent-soft); }
      button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--admin-accent); outline-offset: 2px; }
      label { display: grid; gap: .35rem; color: var(--admin-muted); font-size: .76rem; font-weight: 600; }
      .login { display: grid; grid-template-columns: minmax(0, 24rem) auto; align-items: end; gap: .75rem; max-width: 34rem; margin: 4rem auto; padding: 1.5rem; border: 1px solid var(--admin-line); border-radius: 10px; background: var(--admin-panel); box-shadow: 0 10px 35px #09201614; }
      .login::before { grid-column: 1 / -1; content: '登录后可管理在线笔记、版本和上传资源'; color: var(--admin-accent); font-size: 1rem; font-weight: 750; }
      .status { min-height: 1.5rem; margin: .9rem 0; color: var(--admin-muted); font-size: .8rem; }
      [hidden] { display: none !important; }
      .admin-toolbar { display: grid; grid-template-columns: minmax(14rem, 1.4fr) auto minmax(12rem, 1fr) auto auto; align-items: end; gap: .7rem; margin: 1.1rem 0; padding: 1rem; border: 1px solid var(--admin-line); border-radius: 9px; background: var(--admin-panel); }
      .admin-toolbar label { min-width: 0; }
      .admin-toolbar .toolbar-heading { grid-column: 1 / -1; display: flex; align-items: baseline; justify-content: space-between; gap: .75rem; }
      .admin-toolbar .toolbar-heading h2 { color: var(--admin-accent); font-size: .95rem; }
      .admin-toolbar .toolbar-heading span { color: var(--admin-muted); font-size: .7rem; }
      .workspace { display: grid; grid-template-columns: minmax(18rem, .7fr) minmax(0, 1.8fr); align-items: start; gap: 1rem; }
      .panel { min-width: 0; padding: 1rem; border: 1px solid var(--admin-line); border-radius: 9px; background: var(--admin-panel); }
      .panel-heading { display: flex; align-items: baseline; justify-content: space-between; gap: .8rem; margin-bottom: .8rem; }
      .panel-heading h2 { color: var(--admin-accent); font-size: .92rem; }
      .panel-heading p { margin: 0; color: var(--admin-muted); font-size: .7rem; }
      .taxonomy-tools { display: grid; gap: .7rem; }
      .taxonomy-fields { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: .7rem; }
      .actions, .upload-controls { display: flex; flex-wrap: wrap; gap: .45rem; }
      .action-group { display: grid; gap: .45rem; padding-top: .75rem; border-top: 1px solid var(--admin-line); }
      .action-group small { color: var(--admin-muted); font-size: .68rem; }
      .danger-zone { border-top-color: #c77a7a; }
      .danger-zone button { color: #ad4646; }
      .editor-panel { display: grid; gap: .75rem; }
      .editor-tools { display: flex; align-items: center; justify-content: space-between; gap: .6rem; flex-wrap: wrap; padding-bottom: .7rem; border-bottom: 1px solid var(--admin-line); }
      .editor-tools .actions { gap: .35rem; }
      .editor-tools button[data-save] { border-color: var(--admin-accent); background: var(--admin-accent); color: white; }
      textarea { width: 100%; min-height: min(70vh, 58rem); resize: vertical; padding: 1rem; border: 1px solid var(--admin-line); border-radius: 7px; background: color-mix(in srgb, var(--admin-panel) 82%, var(--admin-bg)); font: .86rem/1.75 "Cascadia Code", Consolas, monospace; tab-size: 2; }
      .upload-controls { padding-top: .7rem; border-top: 1px solid var(--admin-line); }
      dialog { width: min(70rem, calc(100vw - 2rem)); max-height: 88vh; padding: 1.25rem; border: 1px solid var(--admin-line); border-radius: 10px; background: var(--admin-panel); color: CanvasText; box-shadow: 0 20px 70px #0005; }
      dialog::backdrop { background: #07150e99; backdrop-filter: blur(2px); }
      dialog pre { max-height: 48vh; overflow: auto; padding: .8rem; border-radius: 6px; background: var(--admin-bg); color: var(--admin-muted); font-size: .76rem; white-space: pre-wrap; overflow-wrap: anywhere; }
      dialog h2 { margin-bottom: .7rem; color: var(--admin-accent); font-size: 1.05rem; }
      [data-preview-content] { min-width: min(700px, 75vw); overflow-wrap: anywhere; line-height: 1.8; }
      [data-preview-content] img { max-width: 100%; }
      @media (max-width: 980px) { .admin-toolbar { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); } .admin-toolbar .toolbar-heading, .admin-toolbar > [data-logout] { grid-column: 1 / -1; } .workspace { grid-template-columns: 1fr; } }
      @media (max-width: 620px) { body { padding: 1rem .75rem 3rem; } .login { grid-template-columns: 1fr; margin: 2rem auto; } .login::before { grid-column: auto; } .admin-toolbar { grid-template-columns: 1fr; } .admin-toolbar .toolbar-heading, .admin-toolbar > [data-logout] { grid-column: auto; } .taxonomy-fields { grid-template-columns: 1fr; } textarea { min-height: 55vh; font-size: .8rem; } .panel { padding: .8rem; } }
    </style>
  </head>
  <body data-base={base}>
    <header><div><h1>笔记管理</h1><p>在线内容、知识目录与版本维护</p></div><a href={base}>返回阅读</a></header>
    <form class="login" data-login>
      <label>管理员密码<input type="password" autocomplete="current-password" required minlength="1" /></label>
      <button>登录</button>
    </form>
    <p class="status" role="status" aria-live="polite" data-status></p>
    <main data-editor hidden>
      <section class="admin-toolbar" aria-label="当前笔记与版本">
        <div class="toolbar-heading"><h2>当前工作区</h2><span>保存后立即切换在线活动版本</span></div>
        <label>选择笔记<select data-note><option value="">加载笔记目录…</option></select></label>
        <button type="button" data-refresh>重新载入</button>
        <label>历史版本<select data-version><option value="">加载历史…</option></select></label>
        <button type="button" data-restore>恢复所选版本</button>
        <button type="button" data-logout>退出</button>
      </section>
      <div class="workspace">
      <aside class="panel taxonomy-panel" aria-label="知识目录管理">
        <div class="panel-heading"><h2>知识目录</h2><p>新建、整理和回收</p></div>
        <section class="taxonomy-tools">
          <div class="taxonomy-fields">
            <label>名称<input data-title maxlength="120" placeholder="分类或笔记名称" /></label>
            <label>笔记类型<select data-note-type><option value="markdown">Markdown</option><option value="docx">Word</option><option value="gallery">图片集</option></select></label>
            <label>所属/目标分类<select data-parent><option value="">顶层</option></select></label>
            <label>选择分类<select data-category><option value="">选择分类…</option></select></label>
          </div>
          <div class="action-group"><small>创建与导入</small><div class="actions">
          <button type="button" data-create-group>新建分类</button>
          <button type="button" data-create-note>新建笔记</button>
          <button type="button" data-pick="new-folder">导入新文件夹</button>
          </div></div>
          <div class="action-group"><small>整理当前选择</small><div class="actions">
          <button type="button" data-rename>重命名所选笔记</button>
          <button type="button" data-move>移动所选笔记</button>
          <button type="button" data-restore-deleted>恢复所选笔记</button>
          <button type="button" data-rename-category>重命名所选分类</button>
          <button type="button" data-move-category>移动所选分类</button>
          </div></div>
          <div class="action-group danger-zone"><small>回收站</small><div class="actions">
          <button type="button" data-delete>移入回收站</button>
          <button type="button" data-delete-category>移入回收站分类</button>
          <button type="button" data-restore-category>恢复所选分类</button>
          </div></div>
        </section>
      </aside>
      <section class="panel editor-panel" aria-label="笔记编辑与上传">
        <div class="panel-heading"><h2>内容工作区</h2><p>复杂改动在这里完成，轻量标注可在阅读页完成</p></div>
        <div class="editor-tools">
          <div class="actions" data-markdown-controls aria-label="文本格式">
            <button type="button" data-preview>预览正文</button>
            <button type="button" data-wrap="**">加粗</button>
            <button type="button" data-mark>高亮</button>
            <button type="button" data-bg="yellow">黄色底色</button>
            <button type="button" data-bg="green">绿色底色</button>
            <button type="button" data-bg="blue">蓝色底色</button>
            <button type="button" data-wrap="`">行内代码</button>
            <button type="button" data-insert="$$\n\n$$">公式</button>
          </div>
          <div class="actions" data-markdown-controls><button type="button" data-save>保存并立即发布</button></div>
        </div>
        <textarea data-content data-markdown-controls spellcheck="false" aria-label="Markdown 正文"></textarea>
        <div class="action-group"><small>文件更新方式</small>
        <div class="upload-controls" aria-label="上传笔记文件">
          <button type="button" data-pick="main">更新主文件</button>
          <button type="button" data-pick="main-media">主文件和图片文件夹</button>
          <button type="button" data-pick="attachments">仅上传附件</button>
          <button type="button" data-pick="folder">整个文件夹重新识别</button>
          <input hidden type="file" data-upload-main accept=".md,.docx" />
          <input hidden type="file" data-upload-main-media multiple />
          <input hidden type="file" data-upload-attachments multiple />
          <input hidden type="file" data-upload-folder multiple />
          <input hidden type="file" data-upload-new-folder multiple />
        </div></div>
      </section>
      </div>
    </main>
    <dialog data-upload-review aria-label="确认上传清单">
      <form method="dialog">
        <h2>检查上传内容</h2>
        <label>主笔记文件<select data-upload-primary></select></label>
        <p data-upload-summary></p>
        <pre data-upload-files></pre>
        <div class="actions"><button value="cancel">取消</button><button value="confirm" data-upload-confirm>确认并发布</button></div>
      </form>
    </dialog>
    <dialog data-note-preview aria-label="正文预览"><button type="button" data-preview-close>关闭预览</button><article class="sl-markdown-content" data-preview-content></article></dialog>
    <script>
      // @ts-nocheck
      import { mainCandidates, prepareUpload, uploadSourcePath } from '../../lib/live-upload.mjs';
      import { renderNoteMarkdown } from '../../lib/note-markdown.mjs';
      import { sanitizeNoteHtml } from '../../lib/live-markdown';
      import { liveApiHeaders, liveApiUrl } from '../../lib/live-backend';
      const base = document.body.dataset.base || '/';
      const login = document.querySelector('[data-login]');
      const editor = document.querySelector('[data-editor]');
      const select = document.querySelector('[data-note]');
      const versionSelect = document.querySelector('[data-version]');
      const content = document.querySelector('[data-content]');
      const status = document.querySelector('[data-status]');
      let csrf = '';
      let currentVersion = 0;
      let notes = [];
      const say = (text) => { status.textContent = text; };
      const apiUrl = (url) => {
        const path = new URL(url, location.origin).pathname;
        const prefix = base.endsWith('/') ? base : `${base}/`;
        return liveApiUrl(`/${path.startsWith(prefix) ? path.slice(prefix.length) : path.replace(/^\//, '')}`);
      };
      const api = async (url, options = {}) => {
        const response = await fetch(apiUrl(url), { cache: 'no-store', credentials: 'omit', ...options,
          headers: liveApiHeaders({ ...(options.body && !(options.body instanceof Blob) ? { 'content-type': 'application/json' } : {}), ...(options.method && options.method !== 'GET' ? { 'x-csrf-token': csrf } : {}), ...options.headers }) });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          const message = response.status === 409
            ? '云端笔记已在其他会话中更新。请重新载入，比较当前内容后再发布。'
            : data.error || `请求失败 (${response.status})`;
          throw new Error(message);
        }
        return data;
      };
      const flatten = (nodes) => nodes.flatMap((node) => [node, ...flatten(node.children || [])]);
      const flattenNotes = (nodes) => nodes.flatMap((node) => node.kind === 'note' ? [node] : flattenNotes(node.children || []));
      const parentSelect = document.querySelector('[data-parent]');
      const categorySelect = document.querySelector('[data-category]');
      const titleInput = document.querySelector('[data-title]');
      const setAuthenticated = async () => {
        const session = await api(`${base}api/admin/session`);
        csrf = session.csrfToken || '';
        login.hidden = session.authenticated;
        editor.hidden = !session.authenticated;
        if (session.authenticated) await loadTree();
      };
      async function loadTree() {
        const data = await api(`${base}api/admin/taxonomy`);
        const allNodes = flatten(data.tree);
        notes = flattenNotes(data.tree);
        select.replaceChildren(new Option('选择笔记…', ''));
        for (const note of notes) {
          const option = new Option(`${note.deleted ? '（回收站）' : ''}${note.title} · ${note.type}${note.version ? ` · v${note.version}` : ' · 未发布'}`, note.id);
          select.add(option);
        }
        parentSelect.replaceChildren(new Option('顶层', ''));
        for (const node of allNodes.filter((item) => item.kind === 'group' && !item.deleted)) parentSelect.add(new Option(`${'　'.repeat(node.path.split('/').length - 1)}${node.title}`, node.id));
        categorySelect.replaceChildren(new Option('选择分类…', ''));
        for (const node of allNodes.filter((item) => item.kind === 'group')) {
          categorySelect.add(new Option(`${node.deleted ? '（回收站）' : ''}${'　'.repeat(node.path.split('/').length - 1)}${node.title}`, node.id));
        }
      }
      async function loadNote() {
        const note = notes.find((item) => item.id === select.value);
        if (!note) return;
        if (note.deleted) {
          currentVersion = note.version || 0;
          content.value = '';
          document.querySelectorAll('[data-markdown-controls]').forEach((item) => { item.hidden = true; });
          versionSelect.replaceChildren(new Option('回收站中的笔记', ''));
          say(`${note.title} 在回收站中，可恢复后继续管理`);
          return;
        }
        if (!note.version) {
          currentVersion = 0;
          content.value = '';
          document.querySelectorAll('[data-markdown-controls]').forEach((item) => { item.hidden = note.type !== 'markdown'; });
          versionSelect.replaceChildren(new Option('暂无历史版本', ''));
          say(`${note.title} 已创建，上传主文件或编辑 Markdown 后发布第一版`);
          return;
        }
        const data = await api(`${base}api/notes/${note.path.split('/').map(encodeURIComponent).join('/')}`);
        currentVersion = data.version || 0;
        content.value = data.markdown || '';
        document.querySelectorAll('[data-markdown-controls]').forEach((item) => { item.hidden = note.type !== 'markdown'; });
        say(`已载入 ${note.title} · ${note.type} · 版本 ${currentVersion}`);
        await loadVersions(note);
      }
      async function loadVersions(note) {
        const data = await api(`${base}api/admin/notes/${encodeURIComponent(note.id)}/versions`);
        versionSelect.replaceChildren(new Option('版本历史…', ''));
        for (const version of data.versions) versionSelect.add(new Option(`版本 ${version.version} · ${new Date(version.created_at).toLocaleString()}`, String(version.version)));
      }
      const reviewUpload = (files, mode, fixedType) => new Promise((resolve) => {
        const dialog = document.querySelector('[data-upload-review]');
        const primary = dialog.querySelector('[data-upload-primary]');
        const candidates = mode === 'attachments' ? [] : mainCandidates(files, fixedType);
        primary.replaceChildren(...candidates.map((file) => new Option(uploadSourcePath(file), uploadSourcePath(file))));
        const preferred = candidates.find((file) => /^(?:note\.md|note\.docx)$/i.test(uploadSourcePath(file)));
        if (preferred) primary.value = uploadSourcePath(preferred);
        primary.parentElement.hidden = !candidates.length;
        let result = null;
        const update = () => {
          try {
            const type = fixedType || (primary.value ? /\.md$/i.test(primary.value) ? 'markdown' : 'docx' : 'gallery');
            const prepared = prepareUpload(files, type, mode, primary.value);
            result = { type, prepared };
            dialog.querySelector('[data-upload-summary]').textContent = `${type} · ${prepared.length} 个文件 · ${(prepared.reduce((sum, entry) => sum + entry.file.size, 0) / 1024 / 1024).toFixed(1)} MB。${mode === 'folder' ? '完整替换当前文件集合；旧版本仍可恢复。' : '保留本次未更新的文件。'}`;
            dialog.querySelector('[data-upload-files]').textContent = prepared.map(({ file, relative }) => `${uploadSourcePath(file)} → ${relative}`).join('\n');
            dialog.querySelector('[data-upload-confirm]').disabled = false;
          } catch (error) {
            result = null; dialog.querySelector('[data-upload-summary]').textContent = error.message;
            dialog.querySelector('[data-upload-confirm]').disabled = true;
          }
        };
        primary.onchange = update; update();
        dialog.returnValue = ''; dialog.showModal();
        dialog.addEventListener('close', () => resolve(dialog.returnValue === 'confirm' ? result : null), { once: true });
      });
      const runUpload = async (files, mode, reviewed) => {
        const note = notes.find((item) => item.id === select.value);
        if (!note || !files.length) return;
        const review = reviewed || await reviewUpload(files, mode, note.type);
        if (!review) return;
        const prepared = review.prepared;
        const started = await api(`${base}api/admin/notes/${encodeURIComponent(note.id)}/uploads`, {
          method: 'POST', body: JSON.stringify({ expectedVersion: currentVersion, mode, files: prepared.map(({ file, relative }) => ({ path: relative, size: file.size })) }),
        });
        for (let index = 0; index < prepared.length; index++) {
          const { file, relative } = prepared[index];
          say(`正在上传 ${index + 1}/${prepared.length}：${relative}`);
          const uploadPath = `${base}api/admin/notes/${encodeURIComponent(note.id)}/uploads/${encodeURIComponent(started.operationId)}`;
          const reserved = await api(`${uploadPath}?path=${encodeURIComponent(relative)}`, { method: 'POST', body: '{}' });
          // Signed storage URL contains its own short-lived authorization, never the administrator token.
          const uploaded = await fetch(reserved.signedUrl, { method: 'PUT', body: file, headers: { 'content-type': reserved.mime } });
          if (!uploaded.ok) throw new Error(`文件上传失败 (${uploaded.status})：${relative}`);
          await api(`${uploadPath}/complete`, { method: 'POST', body: JSON.stringify({ path: relative, size: file.size }) });

        }
        const published = await api(`${base}api/admin/notes/${encodeURIComponent(note.id)}/uploads/${encodeURIComponent(started.operationId)}/publish`, { method: 'POST', body: '{}' });
        currentVersion = published.version;
        say(`已发布版本 ${currentVersion}，${prepared.length} 个文件已更新`);
        await loadVersions(note);
        await loadTree();
        select.value = note.id;
        await loadNote();
        say(`已发布版本 ${currentVersion}，${prepared.length} 个文件已更新`);
      };
      login.addEventListener('submit', async (event) => {
        event.preventDefault();
        try {
          const password = login.querySelector('input').value;
          const data = await api(`${base}api/auth/login`, { method: 'POST', body: JSON.stringify({ password }) });
          sessionStorage.setItem('notes-admin-session', data.accessToken);
          csrf = data.csrfToken;
          login.reset();
          await setAuthenticated();
          say('已登录');
        } catch (error) { say(error.message); }
      });
      select.addEventListener('change', () => void loadNote().catch((error) => say(error.message)));
      const mutateTaxonomy = async (payload) => api(`${base}api/admin/taxonomy`, { method: 'POST', body: JSON.stringify(payload) });
      document.querySelector('[data-create-group]').addEventListener('click', async () => {
        const title = titleInput.value.trim(); if (!title) return say('请输入分类名称');
        try { const result = await mutateTaxonomy({ action: 'create-group', title, parentId: parentSelect.value || null }); await loadTree(); titleInput.value = ''; say(`分类“${result.title}”已创建`); }
        catch (error) { say(error.message); }
      });
      document.querySelector('[data-create-note]').addEventListener('click', async () => {
        const title = titleInput.value.trim(); if (!title || !parentSelect.value) return say('请输入笔记名称并选择所属分类');
        try {
          const result = await mutateTaxonomy({ action: 'create-note', title, parentId: parentSelect.value, noteType: document.querySelector('[data-note-type]').value });
          await loadTree(); select.value = result.id; await loadNote(); titleInput.value = '';
          say(`笔记“${result.title}”已创建，尚未公开；上传主文件或编辑后发布`);
        } catch (error) { say(error.message); }
      });
      document.querySelector('[data-rename]').addEventListener('click', async () => {
        const note = notes.find((item) => item.id === select.value); const title = titleInput.value.trim();
        if (!note || !title) return say('先选择笔记并输入新名称');
        try { await mutateTaxonomy({ action: 'rename', id: note.id, title }); await loadTree(); select.value = note.id; await loadNote(); titleInput.value = ''; say('笔记已重命名'); }
        catch (error) { say(error.message); }
      });
      document.querySelector('[data-move]').addEventListener('click', async () => {
        const note = notes.find((item) => item.id === select.value);
        if (!note || !parentSelect.value) return say('先选择笔记和目标分类');
        try { await mutateTaxonomy({ action: 'move', id: note.id, parentId: parentSelect.value }); await loadTree(); select.value = note.id; await loadNote(); say('笔记已移动'); }
        catch (error) { say(error.message); }
      });
      document.querySelector('[data-delete]').addEventListener('click', async () => {
        const note = notes.find((item) => item.id === select.value);
        if (!note || !confirm(`将“${note.title}”移入回收站？已发布内容可恢复。`)) return;
        try { await mutateTaxonomy({ action: 'delete', id: note.id }); await loadTree(); select.value = ''; content.value = ''; say('笔记已移入回收站'); }
        catch (error) { say(error.message); }
      });
      document.querySelector('[data-restore-deleted]').addEventListener('click', async () => {
        const note = notes.find((item) => item.id === select.value && item.deleted);
        if (!note) return say('选择一条回收站笔记后再恢复');
        try { await mutateTaxonomy({ action: 'restore', id: note.id }); await loadTree(); select.value = note.id; await loadNote(); say('笔记已恢复'); }
        catch (error) { say(error.message); }
      });
      document.querySelector('[data-rename-category]').addEventListener('click', async () => {
        const category = flatten(await api(`${base}api/admin/taxonomy`).then((data) => data.tree)).find((item) => item.id === categorySelect.value && item.kind === 'group');
        const title = titleInput.value.trim();
        if (!category || category.deleted || !title) return say('选择一个有效分类并输入新名称');
        try { await mutateTaxonomy({ action: 'rename', id: category.id, title }); await loadTree(); categorySelect.value = category.id; titleInput.value = ''; say('分类已重命名'); }
        catch (error) { say(error.message); }
      });
      document.querySelector('[data-move-category]').addEventListener('click', async () => {
        const categoryId = categorySelect.value;
        if (!categoryId) return say('请选择要移动的分类');
        try { await mutateTaxonomy({ action: 'move', id: categoryId, parentId: parentSelect.value || null }); await loadTree(); categorySelect.value = categoryId; say('分类已移动'); }
        catch (error) { say(error.message); }
      });
      document.querySelector('[data-delete-category]').addEventListener('click', async () => {
        const categoryId = categorySelect.value;
        const tree = await api(`${base}api/admin/taxonomy`);
        const category = flatten(tree.tree).find((item) => item.id === categoryId && item.kind === 'group');
        if (!category || category.deleted || !confirm(`将“${category.title}”及其下属全部笔记移入回收站？可整体恢复。`)) return;
        try { await mutateTaxonomy({ action: 'delete', id: category.id }); await loadTree(); categorySelect.value = category.id; say('分类及其内容已移入回收站'); }
        catch (error) { say(error.message); }
      });
      document.querySelector('[data-restore-category]').addEventListener('click', async () => {
        const categoryId = categorySelect.value;
        const tree = await api(`${base}api/admin/taxonomy`);
        const category = flatten(tree.tree).find((item) => item.id === categoryId && item.kind === 'group');
        if (!category || !category.deleted) return say('请选择回收站中的分类');
        try { await mutateTaxonomy({ action: 'restore', id: category.id }); await loadTree(); categorySelect.value = category.id; say('分类及其内容已恢复'); }
        catch (error) { say(error.message); }
      });
      document.querySelector('[data-refresh]').addEventListener('click', () => void loadNote().catch((error) => say(error.message)));
      document.querySelector('[data-restore]').addEventListener('click', async () => {
        const note = notes.find((item) => item.id === select.value);
        const targetVersion = Number(versionSelect.value);
        if (!note || !Number.isInteger(targetVersion) || targetVersion < 1) return say('请选择要恢复的历史版本');
        try {
          const result = await api(`${base}api/admin/notes/${encodeURIComponent(note.id)}/restore`, {
            method: 'POST', body: JSON.stringify({ expectedVersion: currentVersion, targetVersion }),
          });
          currentVersion = result.version;
          await loadNote();
          say(`已恢复到版本 ${currentVersion}`);
        } catch (error) { say(error.message); }
      });
      document.querySelector('[data-save]').addEventListener('click', async () => {
        const note = notes.find((item) => item.id === select.value);
        if (!note) return say('请先选择笔记');
        try {
          const data = await api(`${base}api/admin/notes/${encodeURIComponent(note.id)}/markdown`, {
            method: 'PUT', body: JSON.stringify({ expectedVersion: currentVersion, content: content.value }),
          });
          currentVersion = data.version;
          say(`已发布版本 ${currentVersion}，${data.passageCount} 个搜索段落已更新`);
          await loadVersions(note);
        } catch (error) { say(error.message); }
      });
      document.querySelector('[data-logout]').addEventListener('click', async () => {
        try { await api(`${base}api/auth/logout`, { method: 'POST', body: '{}' }); } catch {}
        sessionStorage.removeItem('notes-admin-session'); csrf = ''; editor.hidden = true; login.hidden = false; say('已退出');
      });
      const wrapSelection = (before, after = before) => {
        const start = content.selectionStart; const end = content.selectionEnd;
        if (start === end) return;
        const selected = content.value.slice(start, end);
        content.setRangeText(`${before}${selected}${after}`, start, end, 'select'); content.focus();
      };
      document.querySelectorAll('[data-wrap]').forEach((button) => button.addEventListener('click', () => wrapSelection(button.dataset.wrap)));
      document.querySelector('[data-mark]').addEventListener('click', () => wrapSelection('<mark>', '</mark>'));
      document.querySelectorAll('[data-bg]').forEach((button) => button.addEventListener('click', () => {
        const colors = { yellow: '#fff2a8', green: '#d7f5dd', blue: '#d9ecff' };
        wrapSelection(`<span style="background-color: ${colors[button.dataset.bg]}">`, '</span>');
      }));
      document.querySelector('[data-insert]').addEventListener('click', (event) => {
        const start = content.selectionStart; const end = content.selectionEnd;
        content.setRangeText(event.currentTarget.dataset.insert, start, end, 'end'); content.focus();
      });
      const preview = document.querySelector('[data-note-preview]');
      document.querySelector('[data-preview]').addEventListener('click', () => {
        preview.querySelector('[data-preview-content]').innerHTML = sanitizeNoteHtml(renderNoteMarkdown(content.value));
        preview.showModal();
      });
      document.querySelector('[data-preview-close]').addEventListener('click', () => preview.close());
      const uploadInputs = { main: '[data-upload-main]', 'main-media': '[data-upload-main-media]', attachments: '[data-upload-attachments]', folder: '[data-upload-folder]' };
      uploadInputs['new-folder'] = '[data-upload-new-folder]';
      for (const mode of ['main-media', 'folder', 'new-folder']) {
        document.querySelector(uploadInputs[mode]).setAttribute('webkitdirectory', '');
        document.querySelector(uploadInputs[mode]).setAttribute('directory', '');
      }
      document.querySelectorAll('[data-pick]').forEach((button) => button.addEventListener('click', () => document.querySelector(uploadInputs[button.dataset.pick]).click()));
      for (const [mode, selector] of Object.entries(uploadInputs)) {
        const input = document.querySelector(selector);
        input.addEventListener('change', async () => {
          try {
            const files = [...input.files];
            if (mode === 'new-folder' && files.length) {
              const review = await reviewUpload(files, 'folder');
              if (!review) return;
              const noteType = review.type;
              const parentId = parentSelect.value;
              if (!parentId) throw new Error('请先选择新笔记所属分类');
              const folderTitle = files[0].webkitRelativePath?.split('/')[0] || '';
              const title = titleInput.value.trim() || folderTitle;
              if (!title) throw new Error('无法识别文件夹名称，请填写笔记名称');
              say(`已识别为 ${noteType === 'markdown' ? 'Markdown' : noteType === 'docx' ? 'Word' : '图片集'}，正在创建笔记…`);
              const result = await mutateTaxonomy({ action: 'create-note', title, parentId, noteType });
              await loadTree(); select.value = result.id; currentVersion = 0; content.value = '';
              await runUpload(files, 'folder', review);
              titleInput.value = '';
            } else await runUpload(files, mode);
          }
          catch (error) { say(error.message); }
          finally { input.value = ''; }
        });
      }
      void setAuthenticated().catch((error) => { login.hidden = false; say(`在线管理尚未就绪：${error.message}`); });
    </script>
  </body>
</html>
