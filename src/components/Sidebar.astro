---
import DirectoryToggle from './DirectoryToggle.astro';
import DirectoryResize from './DirectoryResize.astro';
import TopicTree from './TopicTree.astro';
import { loadTaxonomy } from '../../scripts/taxonomy.mjs';

const taxonomy = loadTaxonomy();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const queryNote = Astro.url.searchParams.get('liveNote');
const currentPath = queryNote ?? Astro.url.pathname.replace(base, '').replace(/^notes\//, '').replace(/\/$/, '');
---

<div class="topic-directory">
  <div class="directory-header">
    <span class="directory-title">知识目录</span>
    <DirectoryToggle directory="topic" controls="note-topic-tree" label="知识目录" />
  </div>
  <div class="directory-collapsed-label" aria-hidden="true">知识目录</div>
  <div class="topic-tree directory-scroll" id="note-topic-tree" tabindex="0" aria-label="知识目录，可独立滚动">
    <TopicTree nodes={taxonomy.groups ?? []} current={currentPath} base={base} />
  </div>
  <DirectoryResize directory="topic" label="知识目录" />
</div>

<script is:inline>
  (() => {
    const tree = document.getElementById('note-topic-tree');
    if (!tree) return;
    const storageKey = 'notes-topic-scroll';
    let pendingScroll = null;
    let ready = document.readyState !== 'loading';
    try {
      const saved = JSON.parse(sessionStorage.getItem(storageKey) || 'null');
      if (Number.isFinite(saved?.scroll) && saved.scroll >= 0) pendingScroll = saved.scroll;
    } catch {}
    const restore = () => {
      if (!ready || pendingScroll === null || tree.clientHeight === 0) return;
      tree.scrollTop = pendingScroll;
      pendingScroll = null;
    };
    const save = () => {
      // A closed directory/menu has no measurable scroll position to save.
      if (!ready || pendingScroll !== null || tree.clientHeight === 0) return;
      try { sessionStorage.setItem(storageKey, JSON.stringify({ scroll: tree.scrollTop })); } catch {}
    };
    // Wait for the menu custom element to upgrade and its scroll area to be sized.
    if (ready) restore();
    else document.addEventListener('DOMContentLoaded', () => { ready = true; restore(); }, { once: true });
    tree.addEventListener('scroll', save, { passive: true });
    tree.addEventListener('click', save);
    window.addEventListener('pagehide', save);
    const bindBranches = () => tree.querySelectorAll('[data-topic-branch]').forEach((details) => {
      const key = `notes-live-branch:${details.dataset.topicBranch}`;
      try { const saved = sessionStorage.getItem(key); if (saved !== null) details.open = saved === 'true'; } catch {}
      if (details.dataset.bound) return;
      details.dataset.bound = 'true';
      details.addEventListener('toggle', () => { try { sessionStorage.setItem(key, String(details.open)); } catch {} });
    });
    bindBranches();
    new ResizeObserver(restore).observe(tree);
  })();
</script>

<script>
  import { getLiveTree, liveReaderUrl } from '../lib/live-backend';
  type RuntimeNode = { id: string; title: string; path: string; kind: 'group' | 'note'; type: 'markdown' | 'docx' | 'gallery'; children?: RuntimeNode[] };
  const tree = document.querySelector<HTMLElement>('#note-topic-tree');
  if (tree) {
    void (async () => {
      const data = await getLiveTree();
      if (!data?.tree.length) return;
      const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
      const current = new URLSearchParams(location.search).get('liveNote') ?? decodeURI(location.pathname).replace(base, '').replace(/^notes\//, '').replace(/\/$/, '');
      const staticScroll = tree.scrollTop;
      let savedScroll = 0;
      try {
        const stored = JSON.parse(sessionStorage.getItem('notes-topic-scroll') || 'null');
        savedScroll = Number.isFinite(stored?.scroll) ? Math.max(0, stored.scroll) : 0;
      } catch {}
      const openBeforeRefresh = new Map<string, boolean>();
      tree.querySelectorAll<HTMLDetailsElement>('[data-topic-branch]').forEach((details) => {
        if (details.dataset.topicBranch) openBeforeRefresh.set(details.dataset.topicBranch, details.open);
      });
      const build = (nodes: RuntimeNode[]): HTMLUListElement => {
        const list = document.createElement('ul'); list.className = 'topic-runtime-list';
        for (const node of nodes) {
          const item = document.createElement('li'); item.className = 'topic-runtime-item';
          const href = node.kind === 'note' ? liveReaderUrl(node) : node.path;
          if (node.kind === 'group') {
            const details = document.createElement('details'); details.dataset.topicBranch = node.path;
            details.open = openBeforeRefresh.get(node.path) ?? (current === node.path || current.startsWith(node.path + '/'));
            try { const saved = sessionStorage.getItem(`notes-live-branch:${node.path}`); if (saved !== null) details.open = saved === 'true'; } catch {}
            details.dataset.bound = 'true';
            details.addEventListener('toggle', () => { try { sessionStorage.setItem(`notes-live-branch:${node.path}`, String(details.open)); } catch {} });
            const summary = document.createElement('summary'); summary.textContent = node.title;
            details.append(summary, build(node.children ?? [])); item.append(details);
          } else {
            const link = document.createElement('a'); link.href = href; link.textContent = node.title;
            if (current === node.path) { link.setAttribute('aria-current', 'page'); }
            item.append(link);
          }
          list.append(item);
        }
        return list;
      };
      tree.replaceChildren(build(data.tree));
      tree.scrollTop = Math.max(staticScroll, savedScroll);
    })().catch((error) => console.error('Could not load the live knowledge tree', error));
  }
</script>

<style>
  .topic-tree :global(.topic-runtime-list) { display: grid; gap: .14rem; margin: 0; padding: 0; list-style: none; }
  .topic-tree :global(.topic-runtime-list .topic-runtime-list) { margin: .16rem 0 .3rem .55rem; padding-left: .55rem; border-left: 1px solid var(--sl-color-gray-5); }
  .topic-tree :global(.topic-runtime-item) { min-width: 0; margin: 0; padding: 0; list-style: none; }
  .topic-tree :global(.topic-runtime-item > details > summary), .topic-tree :global(.topic-runtime-item > a) { display: block; min-width: 0; padding: .38rem .55rem; border-radius: 5px; color: var(--sl-color-text); font-size: .79rem; line-height: 1.45; text-decoration: none; cursor: pointer; }
  .topic-tree :global(.topic-runtime-item > details > summary) { list-style: none; font-weight: 650; }
  .topic-tree :global(.topic-runtime-item > details > summary::-webkit-details-marker) { display: none; }
  .topic-tree :global(.topic-runtime-item > details > summary::after) { float: right; content: '›'; color: var(--sl-color-gray-3); font-size: 1rem; line-height: 1.25; transition: transform .16s ease; }
  .topic-tree :global(.topic-runtime-item > details[open] > summary::after) { transform: rotate(90deg); color: var(--sl-color-accent-high); }
  .topic-tree :global(.topic-runtime-item > details > summary:hover), .topic-tree :global(.topic-runtime-item > a:hover) { background: var(--sl-color-gray-6); color: var(--sl-color-accent-high); }
  .topic-tree :global(.topic-runtime-item > a[aria-current='page']) { background: var(--sl-color-accent-low); box-shadow: inset 3px 0 var(--sl-color-accent); color: var(--sl-color-accent-high); font-weight: 700; }
</style>
