---
import fs from 'node:fs';
import path from 'node:path';
import * as cheerio from 'cheerio';
import { imageSize } from 'image-size';
import { createNoteMarkdownParser, markdownImageAssetPath, renderNoteMarkdown, resolveHeadingFragment } from '../lib/note-markdown.mjs';
import { markdownSearchPassages } from '../lib/note-search.mjs';
import NoteOutline from './NoteOutline.astro';
import AttachmentList from './AttachmentList.astro';
import InlineNoteEditor from './InlineNoteEditor.astro';

const { leafPath = '', runtimeOnly = false } = Astro.props;
const root = path.resolve(process.cwd(), 'notes', ...leafPath.split('/'));
const sourcePath = path.join(root, 'note.md');
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const fileBase = `${base}library/${leafPath}/`;
const markdown = runtimeOnly ? '' : fs.readFileSync(sourcePath, 'utf8');
const parser = createNoteMarkdownParser();
const $ = cheerio.load(renderNoteMarkdown(markdown, parser), null, false);
const external = (value?: string): boolean => /^(?:[a-z]+:|\/\/|#)/i.test(value ?? '');
const decode = (value?: string): string => {
  let decoded = (value ?? '').trim().split(/[?#]/, 1)[0];
  try { decoded = decodeURIComponent(decoded); } catch {}
  decoded = decoded.replaceAll('\\', '/');
  return decoded.replace(/^\/+/, '').replace(/^\.\//, '');
};
const resolveFile = (value?: string): string | null => {
  if (external(value)) return null;
  const normalized = decode(value);
  const candidates = [path.resolve(root, 'media', normalized), path.resolve(root, 'attachments', normalized), path.resolve(root, normalized)];
  return candidates.find((candidate) => fs.existsSync(candidate) && fs.statSync(candidate).isFile()) ?? null;
};
const resolveImageFile = (value?: string): string | null => {
  const relative = markdownImageAssetPath(value ?? '');
  if (!relative) return null;
  const candidate = path.resolve(root, relative);
  const mediaRoot = path.resolve(root, 'media');
  return candidate.startsWith(`${mediaRoot}${path.sep}`) && fs.existsSync(candidate) && fs.statSync(candidate).isFile() ? candidate : null;
};
const publicUrl = (file: string): string => {
  const relative = path.relative(root, file).split(path.sep).map(encodeURIComponent).join('/');
  return `${fileBase}${relative}`;
};
const referenced = new Set<string>();
const headings = $('h1, h2, h3, h4, h5, h6').toArray().map((heading) => ({
  id: $(heading).attr('id') ?? '',
  text: $(heading).text(),
}));

$('img[src], source[src]').each((_, element) => {
  const src = $(element).attr('src');
  if (external(src)) return;
  const file = resolveImageFile(src);
  if (!file) {
    $(element).attr('data-reference-error', markdownImageAssetPath(src ?? '') ? 'missing-media' : 'wrong-directory');
    $(element).removeAttr('src');
    return;
  }
  referenced.add(path.resolve(file));
  $(element).attr('src', publicUrl(file));
  $(element).attr('loading', 'lazy');
  $(element).attr('decoding', 'async');
  if (element.tagName === 'img') {
    // Reserve the image's space before lazy loading so chapter jumps stay aligned.
    const { width, height } = imageSize(fs.readFileSync(file));
    if (width && height) {
      if (!$(element).attr('width') && !$(element).attr('height')) {
        $(element).attr('width', String(width)).attr('height', String(height));
      }
      const style = $(element).attr('style') ?? '';
      $(element).attr('style', `${style};aspect-ratio:auto ${width} / ${height}`);
    }
  }
});

$('a[href]').each((_, element) => {
  const href = $(element).attr('href');
  if (href?.startsWith('#')) {
    const target = resolveHeadingFragment(href, headings);
    if (target) {
      $(element).attr('href', `#${target}`);
      return;
    }
  }
  if (external(href)) return;
  const file = resolveFile(href);
  if (!file) return;
  referenced.add(path.resolve(file));
  $(element).attr('href', publicUrl(file));
  $(element).attr('data-attachment-open', '');
  $(element).attr('data-attachment-url', publicUrl(file));
  $(element).attr('data-attachment-name', path.basename(file));
});

markdownSearchPassages($);

const html = $.root().html() ?? '';
const toc: Array<{ id: string; text: string; level: number }> = [];
$('h1, h2, h3, h4, h5, h6').each((_, element) => {
  const id = $(element).attr('id');
  if (id) toc.push({ id, text: $(element).text(), level: Number(element.tagName.slice(1)) });
});
type OutlineEntry = { id: string; text: string; level: number; children: OutlineEntry[] };
const outline: OutlineEntry[] = [];
const outlineStack: OutlineEntry[] = [];
for (const heading of toc) {
  const entry: OutlineEntry = { ...heading, children: [] };
  while (outlineStack.length && outlineStack.at(-1)!.level >= entry.level) outlineStack.pop();
  if (outlineStack.length) outlineStack.at(-1)!.children.push(entry);
  else outline.push(entry);
  outlineStack.push(entry);
}
---

{(runtimeOnly || outline.length > 0) && <NoteOutline headings={outline} />}
<div class="note-reading-layout" data-search-note={leafPath} data-note-id={leafPath.split('/').at(-1)}>
  <InlineNoteEditor />
  <article class="note-prose sl-markdown-content" set:html={html} />
  <AttachmentList leafPath={leafPath} exclude={[...referenced]} runtimeOnly={runtimeOnly} />
</div>

<script>
  import { getLiveNote, applyLiveNote } from '../lib/live-backend';
  import { sanitizeNoteHtml, assignBrowserPassages } from '../lib/live-markdown';

  const localPath = (source: string): string => {
    let value = source.trim().split(/[?#]/, 1)[0];
    try { value = decodeURIComponent(value); } catch {}
    return value.replaceAll('\\', '/').replace(/^\/+/, '').replace(/^\.\//, '');
  };
  const revealOutlineTarget = (link: HTMLAnchorElement) => {
    const rawId = link.dataset.outlineTarget ?? link.getAttribute('href')?.slice(1) ?? '';
    let id = rawId;
    try { id = decodeURIComponent(rawId); } catch {}
    const target = document.getElementById(rawId) ?? document.getElementById(id);
    if (!target) return;
    if (link.hash) history.replaceState(null, '', link.hash);
    requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
  };

  const renderLiveNote = async (layout: HTMLElement, note: any) => {
    const article = layout.querySelector<HTMLElement>('.note-prose');
    if (!article || typeof note.markdown !== 'string') return;
    const { markdownImageAssetPath, renderNoteMarkdown, resolveHeadingFragment } = await import('../lib/note-markdown.mjs');
    article.innerHTML = sanitizeNoteHtml(renderNoteMarkdown(note.markdown));
    const assets = new Map<string, string>((note.assets ?? []).map((asset: any) => [localPath(asset.relative_path), String(asset.url)] as [string, string]));
    const resolveAsset = (source: string): string | undefined => {
      if (/^(?:[a-z]+:|\/\/|#|data:)/i.test(source)) return undefined;
      const normalized = localPath(source);
      return assets.get(normalized) ?? assets.get(`media/${normalized}`) ?? assets.get(`attachments/${normalized}`) ?? assets.get(normalized.replace(/^\.\.\//, ''));
    };
    article.querySelectorAll<HTMLImageElement>('img[src]').forEach((image) => {
      const source = image.getAttribute('src') ?? '';
      if (/^(?:https?:|\/\/|data:image\/)/i.test(source)) return;
      const mediaPath = markdownImageAssetPath(source);
      const url = mediaPath ? assets.get(mediaPath) : undefined;
      if (url) { image.src = url; image.loading = 'lazy'; image.decoding = 'async'; }
      else { image.dataset.referenceError = mediaPath ? 'missing-media' : 'wrong-directory'; image.removeAttribute('src'); }
    });
    article.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
      const url = resolveAsset(link.getAttribute('href') ?? '');
      if (url) { link.href = url; link.dataset.attachmentOpen = ''; link.dataset.attachmentUrl = url; }
    });
    assignBrowserPassages(article);
    const headingTargets = [...article.querySelectorAll<HTMLElement>('h1,h2,h3,h4,h5,h6')].map((element) => ({ id: element.id, text: element.textContent ?? '' }));
    article.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      const target = resolveHeadingFragment(link.hash, headingTargets);
      if (target) link.href = `#${target}`;
    });
    const outline = document.querySelector<HTMLElement>('[data-outline-tree]');
    if (outline) {
      const headings = [...article.querySelectorAll<HTMLElement>('h1,h2,h3,h4,h5,h6')].map((element) => ({ id: element.id, text: element.textContent?.trim() ?? '', level: Number(element.tagName.slice(1)), children: [] as any[] }));
      const roots: typeof headings = []; const stack: typeof headings = [];
      for (const heading of headings) { while (stack.length && stack.at(-1)!.level >= heading.level) stack.pop(); if (stack.length) stack.at(-1)!.children.push(heading); else roots.push(heading); stack.push(heading); }
      const firstLevel = headings.length ? Math.min(...headings.map((heading) => heading.level)) : 1;
      const build = (entries: typeof headings, nested = false): HTMLUListElement => {
        const list = document.createElement('ul'); if (nested) list.dataset.outlineChildren = '';
        for (const entry of entries) {
          const item = document.createElement('li'); item.dataset.outlineItem = ''; item.dataset.level = String(entry.level); item.dataset.depth = String(entry.level - firstLevel);
          const row = document.createElement('div'); row.className = 'outline-row'; row.style.setProperty('--outline-depth', String(entry.level - firstLevel));
          const link = document.createElement('a'); link.href = `#${entry.id}`; link.title = entry.text; link.dataset.outlineTarget = entry.id; link.textContent = entry.text;
          if (entry.children.length) { link.dataset.outlineBranch = ''; link.setAttribute('aria-expanded', String(entry.level === firstLevel)); link.setAttribute('aria-label', `${entry.level === firstLevel ? '收起' : '展开'}${entry.text}的子目录`); const label = document.createElement('span'); label.className = 'outline-label'; label.textContent = entry.text; const icon = document.createElement('span'); icon.className = 'outline-branch-icon'; icon.setAttribute('aria-hidden', 'true'); icon.textContent = '›'; link.replaceChildren(label, icon); }
          row.append(link); item.append(row);
          if (entry.children.length) { const children = build(entry.children as typeof headings, true); children.hidden = entry.level !== firstLevel; item.append(children); }
          list.append(item);
        }
        return list;
      };
      outline.replaceChildren(build(roots));
      const count = document.querySelector('[data-outline-count]');
      if (count) count.textContent = String(headings.length);
      if (!outline.dataset.bound) { outline.dataset.bound = 'true'; outline.addEventListener('click', (event) => { const link = (event.target as Element).closest<HTMLAnchorElement>('[data-outline-branch]'); if (!link) return; event.preventDefault(); const expanded = link.getAttribute('aria-expanded') !== 'true'; link.setAttribute('aria-expanded', String(expanded)); const children = link.closest('li')?.querySelector<HTMLElement>(':scope > [data-outline-children]'); if (children) children.hidden = !expanded; revealOutlineTarget(link); }); }
      document.dispatchEvent(new CustomEvent('notes:dynamic-content', { detail: { outline: true } }));
    }
    if (location.hash) { let id = location.hash.slice(1); try { id = decodeURIComponent(id); } catch {} requestAnimationFrame(() => document.getElementById(id)?.scrollIntoView({ block: 'start' })); }
    document.dispatchEvent(new CustomEvent('notes:dynamic-content', { detail: { noteId: note.id } }));
  };
  document.querySelectorAll<HTMLElement>('.note-reading-layout[data-note-id]').forEach((layout) => {
    let activeNote: any;
    const load = async (note: any) => { activeNote = note; applyLiveNote(layout, note); await renderLiveNote(layout, note); };
    void (async () => { try { const note = await getLiveNote(layout); if (note && typeof note.markdown === 'string') await load(note); } catch (error) { console.error('Could not load the published note version', error); if (!layout.dataset.noteId) layout.querySelector('.note-prose')!.textContent = '在线笔记暂时无法载入，请稍后刷新重试。'; } })();
    document.addEventListener('notes:note-saved', (event) => { const note = (event as CustomEvent).detail; if (note?.id === activeNote?.id) void load(note); });
    document.addEventListener('notes:inline-preview', (event) => {
      const preview = (event as CustomEvent<{ noteId: string; markdown: string }>).detail;
      if (preview?.noteId === activeNote?.id && typeof preview.markdown === 'string') void renderLiveNote(layout, { ...activeNote, markdown: preview.markdown });
    });
  });
</script>

<style>
  .note-reading-layout { display: grid; grid-template-columns: minmax(0, 1fr); align-items: start; gap: 2rem; max-width: 78rem; margin: 0 auto; }
  .note-prose { min-width: 0; overflow-wrap: anywhere; }
  .note-prose :global([id^='search-paragraph-']) { scroll-margin-top: calc(var(--sl-nav-height) + 1rem); }
  .note-prose :global(img) { max-width: 100%; height: auto; }
  .note-prose :global(table) { display: block; max-width: 100%; overflow-x: auto; }
  .note-prose :global(.katex-display) { max-width: 100%; overflow-x: auto; overflow-y: hidden; padding: .2rem 0 .35rem; }
  .note-prose :global(.katex) { font-size: 1em; }
  .note-prose :global(.note-code-block) { overflow: hidden; margin: 1.2em 0; border: 1px solid var(--note-code-border); border-radius: 5px; background: var(--note-code-bg); color: var(--note-code-fg); }
  .note-prose :global(.note-code-label) { padding: .3rem .8rem; border-bottom: 1px solid var(--note-code-border); color: var(--note-code-label); font: 600 .72rem/1.5 var(--sl-font-mono); text-transform: lowercase; }
  .note-prose :global(.note-code-block pre) { max-width: 100%; margin: 0; padding: .85rem 1rem; overflow: auto; border: 0; border-radius: 0; background: transparent; color: inherit; }
  .note-prose :global(.note-code-block code) { font: .9rem/1.65 var(--sl-font-mono); }
  .note-prose :global(.hljs-comment), .note-prose :global(.hljs-quote) { color: var(--note-code-comment); font-style: italic; }
  .note-prose :global(.hljs-keyword), .note-prose :global(.hljs-selector-tag), .note-prose :global(.hljs-literal), .note-prose :global(.hljs-meta-keyword) { color: var(--note-code-keyword); font-weight: 600; }
  .note-prose :global(.hljs-string), .note-prose :global(.hljs-regexp), .note-prose :global(.hljs-addition) { color: var(--note-code-string); }
  .note-prose :global(.hljs-number), .note-prose :global(.hljs-symbol), .note-prose :global(.hljs-bullet) { color: var(--note-code-number); }
  .note-prose :global(.hljs-title), .note-prose :global(.hljs-title.function_), .note-prose :global(.hljs-section) { color: var(--note-code-title); }
  .note-prose :global(.hljs-built_in), .note-prose :global(.hljs-type), .note-prose :global(.hljs-class .hljs-title) { color: var(--note-code-type); }
  .note-prose :global(.hljs-attr), .note-prose :global(.hljs-attribute), .note-prose :global(.hljs-property) { color: var(--note-code-attribute); }
  .note-prose :global([style*='background-color']) { padding: 0 .12em; border-radius: 2px; color: #23352b; }
  .note-prose :global([style*='background-color'] *) { color: #23352b; }
  @media (min-width: 100rem) {
    .note-reading-layout:has(> :global(.attachment-rail)) { grid-template-columns: minmax(0, 1fr) minmax(11rem, 13rem); }
    .note-reading-layout > :global(.attachment-rail) { position: sticky; top: 5.5rem; }
  }
</style>
