---
import DirectoryToggle from './DirectoryToggle.astro';
import DirectoryResize from './DirectoryResize.astro';
import OutlineTree from './OutlineTree.astro';
interface Heading { id: string; text: string; level: number; children: Heading[] }
interface Props { headings: Heading[] }
const { headings } = Astro.props;
const firstLevel = Math.min(...headings.map((heading) => heading.level));
function count(items: Heading[]): number { return items.reduce((sum, item) => sum + 1 + count(item.children), 0); }
---

<aside class="note-outline" data-note-outline aria-label="本页目录">
  <div class="directory-header">
    <span class="directory-title">本页目录 <small data-outline-count>{count(headings)}</small></span>
    <DirectoryToggle directory="outline" controls="note-page-outline" label="本页目录" />
  </div>
  <div class="outline-bulk-actions">
    <button type="button" data-outline-toggle-all aria-pressed="false">全部展开</button>
  </div>
  <div class="directory-collapsed-label" aria-hidden="true">本页目录</div>
  <nav id="note-page-outline" class="outline-links directory-scroll" tabindex="0" aria-label="笔记章节，可独立滚动">
    <div data-outline-tree><OutlineTree entries={headings} firstLevel={firstLevel} /></div>
  </nav>
  <DirectoryResize directory="outline" label="本页目录" />
</aside>

<script>
  import { initNoteOutline } from '../lib/note-outline';
  document.querySelectorAll<HTMLElement>('aside[data-note-outline]').forEach(initNoteOutline);
</script>
